# ── LLM / API Keys ──────────────────────────────────────────────────────
GOOGLE_API_KEY="your-google-api-key"
LLM_MODEL="gemini-2.5-flash"
TAVILY_API_KEY="your-tavily-api-key"       # optional — mock fallback if missing

# ── LangSmith Tracing (optional) ────────────────────────────────────────
LANGSMITH_TRACING="true"
LANGSMITH_API_KEY="your-langsmith-api-key"
LANGSMITH_PROJECT="adaptive-learning-companion"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"

# ── Database ────────────────────────────────────────────────────────────
# DATABASE_URL="sqlite:///./learnmate.db"   # default, uncomment to override

# ── Vector Store ────────────────────────────────────────────────────────
# CHROMA_PATH="./chroma_db"                 # default, uncomment to override
